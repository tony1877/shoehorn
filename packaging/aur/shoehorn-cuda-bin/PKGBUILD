# Maintainer: tony1877 <https://github.com/tony1877>
# Built from packaging/aur/ in https://github.com/tony1877/shoehorn; the binaries are the release's portable tarball.
pkgname=shoehorn-cuda-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Local inference engine for Qwen3.x with a split-precision residual (CUDA build: NVIDIA RTX 30xx/40xx/50xx; with a CPU fallback)"
arch=('x86_64')
url="https://github.com/tony1877/shoehorn"
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=('nvidia-utils: the NVIDIA driver (570+), for the GPU; without it shoehorn runs its CPU build')
provides=('shoehorn')
conflicts=('shoehorn' 'shoehorn-rocm-bin')
options=('!strip' '!debug')
_dir="shoehorn-${pkgver}-linux-x86_64-cuda"
source=("https://github.com/tony1877/shoehorn/releases/download/v${pkgver}/${_dir}.tar.gz")
sha256sums=('a64b6d470b5250b05f55dcf6de708394ce596eb817dc11a03bbea542f8301307')

package() {
    install -d "$pkgdir/opt/shoehorn" "$pkgdir/usr/bin"
    cp -a "$_dir/." "$pkgdir/opt/shoehorn/"
    ln -s /opt/shoehorn/bin/shoehorn "$pkgdir/usr/bin/shoehorn"
    install -Dm644 "$_dir/systemd/shoehorn.service" "$pkgdir/usr/lib/systemd/user/shoehorn.service"
    install -Dm644 "$_dir/systemd/dsh.service" "$pkgdir/usr/lib/systemd/user/dsh.service"
    sed -i 's|%h/.local/bin/shoehorn|/usr/bin/shoehorn|' "$pkgdir/usr/lib/systemd/user/shoehorn.service"
    install -Dm644 "$_dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$_dir/licenses/ggml-llama.cpp.LICENSE" "$pkgdir/usr/share/licenses/$pkgname/ggml-llama.cpp.LICENSE"
}
