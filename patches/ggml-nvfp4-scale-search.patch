+// NVFP4 with a scale search: per 16-weight sub-block, try UE4M3 codes around amax/6 and keep the one with the least
+// squared error, weighted per column by the importance matrix when there is one. The reference (amax/6, nearest
+// value) only maps the largest weight exactly; a slightly smaller scale often fits the rest of the block better.
+static void quantize_row_nvfp4_search(const float * GGML_RESTRICT x, block_nvfp4 * GGML_RESTRICT y, int64_t k,
+                                      const float * GGML_RESTRICT qw) {
+    const int qk = QK_NVFP4, qk_sub = QK_NVFP4_SUB, n_sub = QK_NVFP4 / QK_NVFP4_SUB;
+    assert(k % qk == 0);
+    const int nb = (int)(k / qk);
+    for (int i = 0; i < nb; i++) {
+        for (int s = 0; s < n_sub; s++) {
+            const float * xb = x + i*qk + s*qk_sub;
+            const float * wb = qw ? qw + i*qk + s*qk_sub : NULL;
+            float amax = 0.0f;
+            for (int j = 0; j < qk_sub; j++) amax = fmaxf(amax, fabsf(xb[j]));
+            const int c0 = ggml_fp32_to_ue4m3(amax / 6.0f);
+            int   best_c   = c0;
+            float best_err = INFINITY;
+            for (int c = c0 - 3; c <= c0 + 2; c++) {
+                if (c < 1 || c > 0x7E) continue;
+                const float d = ggml_ue4m3_to_fp32((uint8_t) c);
+                if (!(d > 0.0f)) continue;
+                float err = 0.0f;
+                for (int j = 0; j < qk_sub; j++) {
+                    const float e = kvalues_mxfp4[best_index_mxfp4(xb[j], d)] * d - xb[j];
+                    err += (wb ? wb[j] : 1.0f) * e * e;
+                }
+                if (err < best_err) { best_err = err; best_c = c; }
+            }
+            if (c0 == 0) best_c = 0;  // an all-zero block
+            y[i].d[s] = (uint8_t) best_c;
+            const float d = ggml_ue4m3_to_fp32((uint8_t) best_c);
+            for (int j = 0; j < qk_sub/2; ++j) {
+                const uint8_t x0 = best_index_mxfp4(xb[0        + j], d);
+                const uint8_t x1 = best_index_mxfp4(xb[qk_sub/2 + j], d);
+                y[i].qs[s*(qk_sub/2) + j] = x0 | (x1 << 4);
+            }
+        }
+    }
+}
+
 size_t quantize_nvfp4(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
-    GGML_UNUSED(quant_weights);
-    quantize_row_nvfp4_ref(src, dst, (int64_t)nrow*n_per_row);
-    return nrow * ggml_row_size(GGML_TYPE_NVFP4, n_per_row);
+    // E8_NVFP4_REF=1: the plain reference (amax/6), as before the search
+    static int ref = -1;
+    if (ref < 0) ref = getenv("E8_NVFP4_REF") && atoi(getenv("E8_NVFP4_REF")) != 0;
+    if (ref) {
+        quantize_row_nvfp4_ref(src, dst, (int64_t)nrow*n_per_row);
+        return nrow * ggml_row_size(GGML_TYPE_NVFP4, n_per_row);
+    }
+    const size_t row_size = ggml_row_size(GGML_TYPE_NVFP4, n_per_row);
+    char * qrow = (char *) dst;
+    for (int64_t r = 0; r < nrow; r++) {
+        quantize_row_nvfp4_search(src + r*n_per_row, (block_nvfp4 *) qrow, n_per_row, quant_weights);
+        qrow += row_size;
+    }
+    return nrow * row_size;
 }
 
